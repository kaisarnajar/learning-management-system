# ==========================================
# ACADEMY LMS - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# Authentication (NextAuth.js)
# ------------------------------------------
# The canonical URL of the application. Required for NextAuth, OAuth callbacks, and email links.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt session tokens. Generate with: `openssl rand -base64 32`
AUTH_SECRET="your-auth-secret-here"

# Google OAuth Credentials (Optional)
# Used for Google Sign-In. Set up at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------------------------------------------
# Database (Neon / PostgreSQL)
# ------------------------------------------
# Connection string for Prisma Client (usually pooled)
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Direct connection string for Prisma Migrations (non-pooled)
DIRECT_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Rate limiting backend (optional). With Upstash Redis set, counters live in Redis;
# otherwise the RateLimitBucket table in Postgres is used. RATE_LIMIT_DISABLED=true turns it off (tests only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# RATE_LIMIT_DISABLED="true"

# Content-Security-Policy is emitted as Report-Only until this is 'true'.
CSP_ENFORCE="false"

# Browser origins allowed to call the mobile REST API (/api/v1) cross-origin, comma-separated.
# Native Android/iOS clients send no Origin header and need no entry. Leave empty to allow none.
API_ALLOWED_ORIGINS=""

# ------------------------------------------
# Role & Access Management
# ------------------------------------------
# Comma-separated email addresses granted full Admin access (must match sign-in email)
ADMIN_EMAIL="admin@youracademy.org,deputy@youracademy.org"

# Email address used for critical system alerts and developer debugging
DEVELOPER_EMAIL="developer@youracademy.org"

# ------------------------------------------
# Email Provider (Nodemailer / SMTP)
# ------------------------------------------
# Required for password resets, certificates, receipts, and fatwa updates.
# If unset, emails will gracefully fallback to console logs.
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-academy@gmail.com"
SMTP_PASS="your-16-char-app-password"

# Display format for outgoing emails: "Display Name <email>"
EMAIL_FROM="Your Academy Name <your-academy@gmail.com>"

# Address where user replies should be directed
EMAIL_REPLY_TO="your-academy@gmail.com"

# ------------------------------------------
# File Storage (Cloudflare R2)
# ------------------------------------------
# Required for user uploads (announcements, library resources, user avatars).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="https://pub-your-id.r2.dev"

# ------------------------------------------
# Development & Testing (Optional)
# ------------------------------------------
# Demo admin logins created by the demo seed (NOT ADMIN_EMAIL: real admins never get a seeded password).
# DEMO_ADMIN_EMAILS="demo-admin@seed.local"

# The demo seed (npm run db:seed:demo) DELETES EVERY ROW before reseeding.
# It only runs when ALLOW_DEMO_SEED is 'true' AND the DATABASE_URL host is listed below.
# Never list the production database host here.
# ALLOW_DEMO_SEED="true"
# SEED_ALLOWED_DB_HOSTS="localhost,ep-your-preview-branch.region.aws.neon.tech"

# Set to 'true' to log raw Prisma SQL queries
# PRISMA_LOG_QUERIES="true"

# Provide the public app URL for specific server actions fallback
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# SEO & Analytics (Google Search Console, GA4, Bing)
# ------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console Verification Token (meta tag content string)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools Verification Token (meta tag content string)
NEXT_PUBLIC_BING_SITE_VERIFICATION=""



