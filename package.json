{
  "name": "darse-quran-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:pdf-css && prisma generate && next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npm run build:pdf-css && prisma generate && prisma migrate deploy && next build",
    "vercel-build:staging": "npm run build:pdf-css && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip --include files,dependencies",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev --skip-seed",
    "db:drift": "bash scripts/check-migration-drift.sh",
    "db:safety": "bash scripts/check-migration-safety.sh",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "build:pdf-css": "bash scripts/build-pdf-css.sh",
    "prebuild": "npm run build:pdf-css"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1074.0",
    "@aws-sdk/s3-request-presigner": "^3.1074.0",
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium-min": "^149.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^1.22.0",
    "next": "16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "puppeteer": "^25.16.0",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "knip": "^6.16.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
