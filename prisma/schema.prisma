generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Occupation {
  STUDENT
  WORKING
  GOVERNMENT_EMPLOYEE
  SELF_EMPLOYED
  LABOURER
  POLICE_OFFICER
  ARMED_FORCES
  TEACHER
  HEALTHCARE_WORKER
  ENGINEER
  IT_PROFESSIONAL
  ACCOUNTANT
  LAWYER
  DRIVER
  FARMER
  SHOPKEEPER
  CLERGY
  HOMEMAKER
  RETIRED
  UNEMPLOYED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  ON_HOLD
  COMING_SOON
}

enum FeeFrequency {
  MONTHLY
  EVERY_3_MONTHS
  EVERY_6_MONTHS
  YEARLY
  ONE_TIME
}

enum AnnouncementCategory {
  EXAMS_TESTS
  ASSIGNMENTS_HOMEWORK
  STUDY_MATERIALS
  CLASS_SCHEDULE
  COURSE_ANNOUNCEMENT
  GENERAL_NOTICE
}

enum DailyInspirationKind {
  QURAN
  HADITH
}

enum BlogApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum FatwaApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentNotificationType {
  PAYMENT_APPROVED
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  COURSE_ANNOUNCEMENT
  PERSONAL_MESSAGE
  SITE_ANNOUNCEMENT
  BOOK_ORDER_APPROVED
  BOOK_ORDER_DECLINED
  BOOK_ORDER_SHIPPED
  BOOK_ORDER_REFUNDED
  BLOG_COMMENT_ADDED
}

enum BookStatus {
  AVAILABLE
  OUT_OF_STOCK
  COMING_SOON
}

enum BookOrderStatus {
  PENDING_VERIFICATION
  APPROVED
  DECLINED
  SHIPPED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  email                    String                    @unique
  fatherName               String?
  dateOfBirth              DateTime?
  occupation               Occupation?
  address                  String?
  whatsapp                 String?
  gender                   Gender?
  registrationNumber       String?                   @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  accounts                 Account[]
  sessions                 Session[]
  enrollments              Enrollment[]
  paymentRecords           PaymentRecord[]
  coursePaymentSubmissions CoursePaymentSubmission[]
  fatwaQuestions           FatwaQuestion[]
  fatwaAnswers             FatwaQuestion[]           @relation("FatwaAnsweredBy")
  contactInquiries         ContactInquiry[]
  contactReplies           ContactInquiry[]          @relation("ContactInquiryRepliedBy")
  siteAnnouncements        SiteAnnouncement[]        @relation("SiteAnnouncementAuthor")
  blogPosts                BlogPost[]                @relation("BlogPostAuthor")
  dailyInspirations        DailyInspiration[]        @relation("DailyInspirationAuthor")
  studentReviews           StudentReview[]
  studentNotifications     StudentNotification[]
  bookOrders               BookOrder[]
  userCartItems            UserCartItem[]
  blogLikes                BlogLike[]
  blogComments             BlogComment[]
  policiesAcceptedAt       DateTime?
  policiesAcceptedVersion  String?
  /// Soft delete; the account can no longer sign in and is hidden from lists.
  deletedAt                DateTime?
  coupons                  Coupon[]
  couponRequests           CouponRequest[]
  couponUsages             CouponUsage[]
  deviceTokens             DeviceToken[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([deletedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

/**
 * One-time tokens for email password reset (hashed at rest).
 */
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Course {
  id                 String               @id
  title              String
  description        String
  startDate          String
  duration           String
  level              String
  category           String
  priceInrPaise      Int
  monthlyFeeInrPaise Int
  feeFrequency       FeeFrequency?
  teacherId          String?
  status             CourseStatus         @default(PUBLISHED)
  featuredOnHomepage Boolean              @default(false)
  featuredAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  teacher            Teacher?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  paymentRecords     PaymentRecord[]
  announcements      CourseAnnouncement[]
  attendances        CourseAttendance[]
  grades             CourseGrade[]
  coupons            Coupon[]
  couponRequests     CouponRequest[]

  @@index([featuredOnHomepage, featuredAt])
  @@index([teacherId])
}

model Teacher {
  id             String               @id
  name           String
  email          String?              @unique
  specialization String
  bio            String
  initials       String
  imageUrl       String?
  published      Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  courses        Course[]
  announcements  CourseAnnouncement[]
  expenses       Expense[]
}

model CourseAnnouncement {
  id             String               @id @default(cuid())
  courseId       String
  enrollmentId   String?
  teacherId      String?
  authorName     String
  postedByAdmin  Boolean              @default(false)
  category       AnnouncementCategory
  title          String
  body           String
  attachmentPath String?
  attachmentName String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment     Enrollment?          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  teacher        Teacher?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([courseId, createdAt])
  @@index([enrollmentId])
  @@index([courseId, enrollmentId])
}

model SiteAnnouncement {
  id             String                  @id @default(cuid())
  title          String
  body           String
  eventDate      String?
  location       String?
  showOnHomepage Boolean                 @default(false)
  published      Boolean                 @default(true)
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  createdBy      User?                   @relation("SiteAnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  images         SiteAnnouncementImage[]

  @@index([published, showOnHomepage])
  @@index([published, createdAt])
}

model SiteAnnouncementImage {
  id                 String           @id @default(cuid())
  siteAnnouncementId String
  imagePath          String
  caption            String?
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  siteAnnouncement   SiteAnnouncement @relation(fields: [siteAnnouncementId], references: [id], onDelete: Cascade)

  @@index([siteAnnouncementId, sortOrder])
}

model BlogPost {
  id                 String             @id @default(cuid())
  title              String
  excerpt            String?
  body               String
  published          Boolean            @default(false)
  approvalStatus     BlogApprovalStatus @default(APPROVED)
  featuredOnHomepage Boolean            @default(false)
  featuredAt         DateTime?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          User?              @relation("BlogPostAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  images             BlogImage[]
  likes              BlogLike[]
  comments           BlogComment[]

  @@index([published, approvalStatus, createdAt])
  @@index([approvalStatus, createdAt])
  @@index([featuredOnHomepage, featuredAt])
}

model BlogLike {
  id         String   @id @default(cuid())
  userId     String
  blogPostId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([userId, blogPostId])
  @@index([blogPostId])
}

model BlogComment {
  id         String   @id @default(cuid())
  userId     String
  blogPostId String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([userId])
}

model BlogImage {
  id         String   @id @default(cuid())
  blogPostId String
  imagePath  String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId, sortOrder])
}

model DailyInspiration {
  id                 String               @id @default(cuid())
  kind               DailyInspirationKind
  arabicText         String
  englishTranslation String
  reference          String?
  published          Boolean              @default(false)
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdBy          User?                @relation("DailyInspirationAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([published, updatedAt])
}

model StudentReview {
  id                 String              @id @default(cuid())
  userId             String
  quote              String
  course             String?
  location           String?
  rating             Int                 @default(5)
  status             StudentReviewStatus @default(PENDING)
  featuredOnHomepage Boolean             @default(false)
  featuredAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([featuredOnHomepage, featuredAt])
  @@index([userId, status])
}

model LibraryItem {
  id                 String    @id
  title              String
  author             String
  topic              String
  level              String
  language           String
  pdfUrl             String?
  imagePath          String?
  published          Boolean   @default(true)
  featuredOnHomepage Boolean   @default(false)
  featuredAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([featuredOnHomepage, featuredAt])
}

model Enrollment {
  id                     String                   @id @default(cuid())
  userId                 String
  courseId               String
  status                 String                   @default("pending_approval")
  rollNumber             Int?
  certificateNumber      String?                  @unique
  certificateGeneratedAt DateTime?
  certificateType        String?
  certificateGrade       Int?
  completedAt            DateTime?
  certificateEmailSentAt DateTime?
  /// Set when an admin rejects the enrollment request (kept for history instead of deleting).
  rejectedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcements          CourseAnnouncement[]
  attendanceRecords      CourseAttendanceRecord[]
  gradeRecords           CourseGradeRecord[]

  @@unique([userId, courseId])
  @@unique([courseId, rollNumber])
  @@index([courseId])
}

model FatwaQuestion {
  id                 String              @id @default(cuid())
  userId             String?
  askerName          String
  askerEmail         String
  category           String
  title              String
  question           String
  answer             String?
  approvalStatus     FatwaApprovalStatus @default(APPROVED)
  answeredAt         DateTime?
  answeredById       String?
  featuredOnHomepage Boolean             @default(false)
  featuredAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  answeredBy         User?               @relation("FatwaAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([answeredAt])
  @@index([featuredOnHomepage, featuredAt])
}

model ContactInquiry {
  id          String    @id @default(cuid())
  userId      String?
  name        String
  email       String
  phone       String
  message     String
  reply       String?
  repliedAt   DateTime?
  repliedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  repliedBy   User?     @relation("ContactInquiryRepliedBy", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([repliedAt])
  @@index([createdAt])
}

model PaymentRecord {
  id                    String                   @id @default(cuid())
  userId                String
  courseId              String?
  amountInrPaise        Int
  paidAt                DateTime
  paymentType           String?
  invoiceNumber         String?                  @unique
  description           String?
  receiptEmailSentAt    DateTime?
  receiptGeneratedAt    DateTime?
  receiptIncludesGst    Boolean?
  receiptFeeAmountPaise Int?
  receiptGstAmountPaise Int?
  /// Set when an admin voids the record; voided records are excluded from finance and receipts.
  voidedAt              DateTime?
  voidReason            String?
  voidedById            String?
  /// The book order this record paid for (book_purchase records only).
  bookOrderId           String?                  @unique
  /// Shipping component captured when the receipt was generated.
  receiptShippingAmountPaise Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course                Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  bookOrder             BookOrder?               @relation(fields: [bookOrderId], references: [id], onDelete: SetNull)
  submission            CoursePaymentSubmission?

  @@index([userId])
  @@index([paidAt])
  @@index([courseId])
  @@index([paymentType])
  @@index([voidedAt])
}

/**
 * Academy operational expenses (salaries, hosting, etc.).
 */
model Expense {
  id             String   @id @default(cuid())
  category       String
  amountInrPaise Int
  paidAt         DateTime
  description    String?
  teacherId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([paidAt])
  @@index([teacherId])
}

/**
 * Academy UPI and bank details (single row, id = "default"). Editable in admin.
 */
model PaymentSettings {
  id                  String   @id @default("default")
  upiId               String   @default("")
  upiNumber           String   @default("")
  upiPayeeName        String   @default("Darse Quran Academy")
  bankAccountName     String   @default("Darse Quran Academy")
  bankName            String   @default("")
  bankAccountNumber   String   @default("")
  bankIfsc            String   @default("")
  bankBranch          String   @default("")
  includeGstByDefault Boolean  @default(false)
  feeWaiverEnabled    Boolean  @default(false)
  /// When false (default) a 100% fee waiver still needs admin confirmation like any other payment.
  autoApproveFullWaivers Boolean @default(false)
  updatedAt           DateTime @updatedAt
}

/**
 * Student-submitted monthly or enrollment course fees awaiting admin approval.
 */
model CoursePaymentSubmission {
  id                    String         @id @default(cuid())
  userId                String
  courseId              String
  paymentType           String         @default("monthly")
  label                 String
  amountInrPaise        Int
  status                String         @default("pending_verification")
  paymentMethod         String?
  upiTransactionId      String?
  paymentScreenshotPath String?
  paymentReference      String?        @unique
  paymentRecordId       String?        @unique
  couponId              String?
  /// Soft delete; rows with deletedAt set are hidden from every list.
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentRecord         PaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  coupon                Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([paymentType])
  @@index([couponId])
}

model StudentNotification {
  id         String                  @id @default(cuid())
  userId     String
  type       StudentNotificationType
  title      String
  body       String?
  href       String
  readAt     DateTime?
  sourceType String?
  sourceId   String?
  createdAt  DateTime                @default(now())
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/**
 * Physical books available for purchase in the bookstore.
 */
model Book {
  id                    String          @id @default(cuid())
  title                 String
  author                String
  description           String
  priceInrPaise         Int
  mrpInrPaise           Int             @default(0)
  purchasePriceInrPaise Int             @default(0)
  weightInGrams         Int             @default(0)
  inventoryPurchased    Int             @default(0)
  status                BookStatus      @default(AVAILABLE)
  imagePath             String?
  published             Boolean         @default(true)
  featuredOnHomepage    Boolean         @default(false)
  featuredAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  orderItems            BookOrderItem[]
  userCartItems         UserCartItem[]
  stockMovements        BookStockMovement[]

  @@index([status])
  @@index([published, status])
}

/**
 * A user's book purchase order submitted for admin approval.
 */
model BookOrder {
  id                     String          @id @default(cuid())
  userId                 String
  totalAmountInrPaise    Int
  shippingChargeInrPaise Int             @default(0)
  status                 BookOrderStatus @default(PENDING_VERIFICATION)
  paymentMethod          String?
  upiTransactionId       String?
  paymentScreenshotPath  String?
  notes                  String?
  deliveryAddress        String          @default("No address provided")
  deliveryPinCode        String?
  deliveryPhoneNumber    String?
  courierServiceName     String?
  trackingId             String?
  /// Soft delete; rows with deletedAt set are hidden from every list.
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                  BookOrderItem[]
  paymentRecords         PaymentRecord[]
  stockMovements         BookStockMovement[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/**
 * Line items in a book order.
 */
model BookOrderItem {
  id                      String    @id @default(cuid())
  orderId                 String
  bookId                  String
  quantity                Int       @default(1)
  priceAtPurchaseInrPaise Int
  createdAt               DateTime  @default(now())
  order                   BookOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book                    Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([bookId])
}

/**
 * Configurable weight slabs and their associated shipping charges.
 */
model ShippingChargeSlab {
  id             String   @id @default(cuid())
  minWeightGrams Int
  maxWeightGrams Int
  chargeInrPaise Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([minWeightGrams, maxWeightGrams])
}

model CourseAttendance {
  id        String   @id @default(cuid())
  courseId  String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  records CourseAttendanceRecord[]

  @@unique([courseId, date])
  @@index([courseId])
  @@index([date])
}

model CourseAttendanceRecord {
  id           String   @id @default(cuid())
  attendanceId String
  enrollmentId String
  isPresent    Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance CourseAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, enrollmentId])
  @@index([enrollmentId])
}

model CourseGrade {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  date      DateTime @db.Date
  maxMarks  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  records CourseGradeRecord[]

  @@index([courseId])
  @@index([date])
}

model CourseGradeRecord {
  id            String   @id @default(cuid())
  gradeId       String
  enrollmentId  String
  marksObtained Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grade      CourseGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([gradeId, enrollmentId])
  @@index([enrollmentId])
}

enum CouponType {
  DEFAULT
  SPECIAL
}

enum CouponRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  type              CouponType
  percentage        Int
  validFrom         DateTime
  validUntil        DateTime
  courseId          String?
  gender            String?
  userId            String?
  isActive          Boolean    @default(true)
  applyToEnrollment Boolean    @default(true)
  applyToCourse     Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  course      Course?                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user        User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  requests    CouponRequest[]
  usages      CouponUsage[]
  submissions CoursePaymentSubmission[]

  @@index([courseId])
  @@index([userId])
  @@index([code])
}

model CouponRequest {
  id        String              @id @default(cuid())
  userId    String
  courseId  String
  reason    String
  status    CouponRequestStatus @default(PENDING)
  couponId  String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([couponId])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([couponId, userId])
  @@index([userId])
  @@index([couponId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserCartItem {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

/**
 * Fixed-window counters for the Postgres-backed rate limiter (services/rate-limit.ts).
 * Rows are tiny and overwritten in place; stale rows may be pruned at any time.
 */
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

/**
 * Per-financial-year counters for sequential invoice/certificate numbers
 * (services/document-numbers.ts). Allocated with an atomic upsert.
 */
model DocumentSequence {
  kind      String
  period    String
  next      Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([kind, period])
}

/**
 * Append-only audit trail of admin mutations (void, delete, approve, …).
 * Written by services/audit.ts inside the same transaction as the change.
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/**
 * Manual stock adjustments (damaged copies, recounts). Available stock is
 * inventoryPurchased + sum(delta) - quantities in approved/shipped orders;
 * see services/inventory.ts.
 */
model BookStockMovement {
  id          String    @id @default(cuid())
  bookId      String
  orderId     String?
  delta       Int
  reason      String
  createdById String?
  createdAt   DateTime  @default(now())

  book  Book       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  order BookOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([orderId])
}
